{
  "componentName": "Page",
  "state": {
    "myMoney": 100,
    "opponentMoney": 100,
    "rounds": 0,
    "gameOver": false,
    "loser": "",
    "history": [],
    "chartData": [],
    "winAmount": 1,
    "loseAmount": 10,
    "tossCount": 3
  },
  "methods": {
    "simulateAll": {
      "type": "JSFunction",
      "value": "function() { this.resetGame(); while (!this.state.gameOver) { const opponentWins = Math.random() < (1 - Math.pow(0.5, this.state.tossCount)); if (opponentWins) { this.state.myMoney -= this.state.winAmount; this.state.opponentMoney += this.state.winAmount; } else { this.state.myMoney += this.state.loseAmount; this.state.opponentMoney -= this.state.loseAmount; } this.state.rounds += 1; this.state.history.push({ round: this.state.rounds, result: opponentWins ? '对手胜' : '你胜', myMoney: this.state.myMoney, opponentMoney: this.state.opponentMoney }); this.state.chartData.push({ round: this.state.rounds, myMoney: this.state.myMoney, opponentMoney: this.state.opponentMoney }); if (this.state.myMoney <= 0) { this.state.gameOver = true; this.state.loser = '你'; } else if (this.state.opponentMoney <= 0) { this.state.gameOver = true; this.state.loser = '对手'; } } this.callAction('saveState', {}); }"
    },
    "resetGame": {
      "type": "JSFunction",
      "value": "function() { this.state.myMoney = 100; this.state.opponentMoney = 100; this.state.rounds = 0; this.state.gameOver = false; this.state.loser = ''; this.state.history = []; this.state.chartData = []; this.callAction('saveState', {}); }"
    }
  },
  "children": [
    {
      "componentName": "TinyCard",
      "children": [
        {
          "componentName": "h2",
          "children": "硬币游戏模拟 - 可配置参数"
        },
        {
          "componentName": "p",
          "children": "规则：对手抛N次硬币，至少一次正面向上则对手胜，对手胜得X元；否则你胜，对手输Y元。双方各100元，看谁先输光。"
        },
        {
          "componentName": "TinyForm",
          "props": {
            "labelWidth": "120px",
            "labelPosition": "left"
          },
          "children": [
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "对手胜得金额"
              },
              "children": [
                {
                  "componentName": "TinyNumeric",
                  "props": {
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.winAmount"
                    },
                    "min": 0,
                    "step": 1
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "对手输赔金额"
              },
              "children": [
                {
                  "componentName": "TinyNumeric",
                  "props": {
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.loseAmount"
                    },
                    "min": 0,
                    "step": 1
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "连续抛硬币次数"
              },
              "children": [
                {
                  "componentName": "TinyNumeric",
                  "props": {
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.tossCount"
                    },
                    "min": 1,
                    "step": 1
                  }
                }
              ]
            }
          ]
        },
        {
          "componentName": "div",
          "props": {
            "style": "display: flex; gap: 20px; margin: 16px 0;"
          },
          "children": [
            {
              "componentName": "TinyCard",
              "props": {
                "title": "你的资金"
              },
              "children": [
                {
                  "componentName": "Text",
                  "props": {
                    "text": {
                      "type": "JSExpression",
                      "value": "this.state.myMoney + ' 元'"
                    },
                    "style": "font-size: 24px; font-weight: bold;"
                  }
                }
              ]
            },
            {
              "componentName": "TinyCard",
              "props": {
                "title": "对手资金"
              },
              "children": [
                {
                  "componentName": "Text",
                  "props": {
                    "text": {
                      "type": "JSExpression",
                      "value": "this.state.opponentMoney + ' 元'"
                    },
                    "style": "font-size: 24px; font-weight: bold;"
                  }
                }
              ]
            }
          ]
        },
        {
          "componentName": "div",
          "props": {
            "style": "margin-bottom: 16px;"
          },
          "children": [
            {
              "componentName": "TinyButton",
              "props": {
                "text": "一次性模拟至破产",
                "type": "primary",
                "onClick": {
                  "type": "JSFunction",
                  "value": "function() { this.simulateAll(); }"
                }
              }
            },
            {
              "componentName": "TinyButton",
              "props": {
                "text": "重置游戏",
                "type": "default",
                "style": "margin-left: 10px;",
                "onClick": {
                  "type": "JSFunction",
                  "value": "function() { this.resetGame(); }"
                }
              }
            }
          ]
        },
        {
          "componentName": "div",
          "props": {
            "condition": {
              "type": "JSExpression",
              "value": "this.state.gameOver"
            },
            "style": "margin-bottom: 16px;"
          },
          "children": [
            {
              "componentName": "h3",
              "children": {
                "type": "JSExpression",
                "value": "'游戏结束！' + this.state.loser + ' 先输光了！共进行了 ' + this.state.rounds + ' 局'"
              }
            }
          ]
        },
        {
          "componentName": "TinyHuichartsLine",
          "props": {
            "options": {
              "theme": "hdesign-light",
              "padding": [50, 30, 50, 20],
              "legend": {
                "show": true,
                "icon": "line"
              },
              "data": {
                "type": "JSExpression",
                "value": "this.state.chartData"
              },
              "xAxis": {
                "data": "round"
              },
              "yAxis": {
                "name": "资金(元)"
              }
            }
          }
        }
      ]
    }
  ]
}
