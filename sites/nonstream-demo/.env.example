# 前端配置。复制成同目录的 .env（.env 已被根 .gitignore 忽略，不会提交）。
#
# 端口必须和 server 里写死的 3100 一致。
VITE_CHAT_URL=http://localhost:3100/chat/completions

# 默认模型名。要填 server/.env 里 BASE_URL 那个网关认识的模型 id。
#   DeepSeek 官方（api.deepseek.com）  → deepseek-chat / deepseek-reasoner
#   华为 ModelArts（api.modelarts-maas.com）→ deepseek-v4-flash 等
# 不能留空：GenuiChat 会把 "model": "" 原样发出去，上游会报错。
# 页面上也有输入框，运行时可以随时改。
VITE_MODEL=deepseek-chat
