{
  "name": "genui-sdk-nonstream-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "手工验证 genui-server 的非流式能力与 GenuiChat 的 :stream=\"false\" 渲染",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch --env-file=server/.env --include server/.env server/start.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@opentiny/genui-sdk-core": "workspace:*",
    "@opentiny/genui-sdk-materials-vue-opentiny-vue": "workspace:*",
    "@opentiny/genui-sdk-server": "workspace:*",
    "@opentiny/genui-sdk-vue": "workspace:*",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.1.2",
    "less": "^4.1.3",
    "tsx": "^4.8.1",
    "vite": "^7.1.2",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}
