                      "type": "JSExpression",
                      "value": "this.state.counter.value"
                    }
                  }
                }
              ]
            },
            {
              "componentName": "AntButton",
              "props": {
                "onClick": {
                  "type": "JSExpression",
                  "value": "this.increment"
                }
              },
              "children": "count++"
            }
          ]
        },
        {
          "componentName": "div",
          "props": {
            "className": "op-section"
          },
          "children": [
