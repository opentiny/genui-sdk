{
  "componentName": "Page",
  "state": {
    "counter": {
      "value": 0
    },
    "user": {
      "name": "张三",
      "age": 30
    },
    "list": [
      { "id": 1, "name": "苹果" },
      { "id": 2, "name": "香蕉" },
      { "id": 3, "name": "橙子" }
    ],
    "obj": {
      "key": "value"
    },
    "asyncTimeout": {
      "value": 0,
      "status": "未执行"
    },
    "asyncPromise": {
      "name": "-",
      "status": "未执行"
    },
    "asyncAwait": {
      "value": 0,
      "status": "未执行"
    },
    "asyncChain": {
      "value": 0,
      "status": "未执行"
    }
  },
  "methods": {
    "increment": {
      "type": "JSFunction",
      "value": "function increment() { this.state.counter.value++; }"
    },
    "decrement": {
      "type": "JSFunction",
      "value": "function decrement() { this.state.counter.value--; }"
    },
    "setNested": {
      "type": "JSFunction",
      "value": "function setNested() { this.state.user.name = '李四'; this.state.user.age = 31; }"
    },
    "pushItem": {
      "type": "JSFunction",
      "value": "function pushItem() { this.state.list.push({ id: this.state.list.length + 1, name: '葡萄' }); }"
    },
    "deleteKey": {
      "type": "JSFunction",
      "value": "function deleteKey() { delete this.state.obj.key; }"
    },
    "runSetTimeout": {
      "type": "JSFunction",
      "value": "function runSetTimeout() { this.state.asyncTimeout.status = '等待 1s...'; setTimeout(() => { this.state.asyncTimeout.value = this.state.asyncTimeout.value + 100; this.state.asyncTimeout.status = '完成 count + 100'; }, 1000); }"
    },
    "runPromiseThen": {
      "type": "JSFunction",
      "value": "function runPromiseThen() { this.state.asyncPromise.status = '进行中...'; Promise.resolve('ok').then((res) => { this.state.asyncPromise.name = '异步-' + res; this.state.asyncPromise.status = '完成'; }); }"
    },
    "runAwait": {
      "type": "JSFunction",
      "value": "async function runAwait() { this.state.asyncAwait.status = '进行中...'; await new Promise((r) => setTimeout(r, 800)); this.state.asyncAwait.value = 500; this.state.asyncAwait.status = '完成 count = 500'; }"
    },
    "runChain": {
      "type": "JSFunction",
      "value": "async function runChain() { this.state.asyncChain.status = '链式进行中...'; await new Promise((r) => setTimeout(r, 300)); this.state.asyncChain.value += 1; await new Promise((r) => setTimeout(r, 300)); this.state.asyncChain.value += 1; await new Promise((r) => setTimeout(r, 300)); this.state.asyncChain.value += 1; this.state.asyncChain.status = '完成 count += 3'; }"
    }
  },
  "children": [
    {
      "componentName": "AntCard",
      "props": {
        "title": "State 转换 / 异步操作演示",
        "style": "max-width: 720px; margin: 0 auto;"
      },
      "children": [
        {
          "componentName": "div",
          "props": {
            "className": "op-section"
          },
          "children": [
            {
              "componentName": "h3",
