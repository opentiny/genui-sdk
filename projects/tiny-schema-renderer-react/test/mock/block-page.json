                "text": {
                  "type": "JSExpression",
                  "value": "`外部 header：${this.state.formItemList[0].label} + ${title}`"
                }
              }
            }
          ]
        },
        {
          "componentName": "Template",
          "props": {
            "slot": "footer"
          },
          "children": [
            {
              "componentName": "Text",
              "props": {
                "text": {
                  "type": "JSExpression",
                  "value": "`外部 footer：${this.state.formItemList[1].label}`"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
