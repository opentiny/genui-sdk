{
  "componentName": "Page",
  "state": {
    "formItemList": [
      {
        "label": "表单标签 A"
      },
      {
        "label": "表单标签 B"
      }
    ]
  },
  "children": [
    {
      "componentName": "TestBlock",
      "props": {
        "text": "来自外部属性",
        "onClickText": {
          "type": "JSFunction",
          "value": "function(event) { console.log('block event clickText', event) }"
        }
      },
      "children": [
        {
          "componentName": "Template",
          "props": {
            "slot": "header",
