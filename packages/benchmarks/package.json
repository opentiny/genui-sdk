{
  "name": "@opentiny/genui-sdk-benchmarks",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmarks": "tsx ./main.ts",
    "benchmarks:cli": "tsx ./main.ts --cli",
    "benchmarks:ui": "tsx ./main.ts",
    "benchmarks:smoke": "BENCH_SUITE=smoke BENCH_UI=false tsx ./main.ts --cli",
    "benchmarks:nightly": "BENCH_SUITE=nightly BENCH_UI=false tsx ./main.ts --cli",
    "benchmarks:release": "BENCH_SUITE=release BENCH_UI=false tsx ./main.ts --cli",
    "benchmarks:diff": "node ./scripts/diff-reports.mjs",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^1.0.7",
    "@opentiny/genui-sdk-core": "workspace:*",
    "@opentiny/genui-sdk-materials-angular-opentiny-ng": "workspace:*",
    "@opentiny/genui-sdk-materials-vue-opentiny-vue": "workspace:*",
    "ai": "^6.0.137",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
