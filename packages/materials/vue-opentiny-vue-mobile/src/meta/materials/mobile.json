{
  "data": {
    "framework": "Vue",
    "materials": {
      "components": [
        {
          "version": "3.31.0",
          "component": "TinyTabbar",
          "name": { "zh_CN": "底部导航栏" },
          "description": "固定在页面底部的移动端导航栏，包含 3 到 5 个 TinyTabbarItem 子项",
          "schema": {
            "properties": [
              {
                "label": { "zh_CN": "基础信息" },
                "content": [
                  {
                    "property": "modelValue",
                    "label": { "text": { "zh_CN": "选中项" } },
                    "description": { "zh_CN": "当前选中标签项的 name 值，支持 v-model" }
                  },
                  {
                    "property": "border",
                    "label": { "text": { "zh_CN": "分隔线" } },
                    "description": { "zh_CN": "是否显示顶部分隔线，默认为 true" }
                  },
                  {
                    "property": "activeColor",
                    "label": { "text": { "zh_CN": "选中颜色" } },
                    "description": { "zh_CN": "选中标签项的文字与图标颜色" }
                  },
                  {
                    "property": "inactiveColor",
                    "label": { "text": { "zh_CN": "未选中颜色" } },
                    "description": { "zh_CN": "未选中标签项的文字与图标颜色" }
                  }
                ]
              }
            ],
            "slots": {
              "default": {
                "label": { "zh_CN": "标签项" },
                "description": { "zh_CN": "放置 TinyTabbarItem 子组件" }
              }
            }
          }
        },
        {
          "version": "3.31.0",
          "component": "TinyTabbarItem",
          "name": { "zh_CN": "底部导航项" },
          "description": "底部导航栏中的单个标签项",
          "schema": {
            "properties": [
              {
                "label": { "zh_CN": "基础信息" },
                "content": [
                  {
                    "property": "name",
                    "label": { "text": { "zh_CN": "名称" } },
                    "description": { "zh_CN": "标签项的唯一标识，与 TinyTabbar 的 modelValue 对应" }
                  },
                  {
                    "property": "text",
                    "label": { "text": { "zh_CN": "文字" } },
                    "description": { "zh_CN": "标签项显示的文字" }
                  },
                  {
                    "property": "badge",
                    "label": { "text": { "zh_CN": "徽标" } },
                    "description": { "zh_CN": "显示在标签项上的数字或文字徽标" }
                  },
                  {
                    "property": "dot",
                    "label": { "text": { "zh_CN": "红点" } },
                    "description": { "zh_CN": "是否显示小红点" }
                  }
                ]
              }
            ]
          }
        },
        {
          "version": "3.31.0",
          "component": "TinyActionSheet",
          "name": { "zh_CN": "操作面板" },
          "description": "从底部弹出的操作面板，常用于让用户从一组操作中选择",
          "schema": {
            "properties": [
              {
                "label": { "zh_CN": "基础信息" },
                "content": [
                  {
                    "property": "modelValue",
                    "label": { "text": { "zh_CN": "是否显示" } },
                    "description": { "zh_CN": "是否显示操作面板，支持 v-model" }
                  },
                  {
                    "property": "title",
                    "label": { "text": { "zh_CN": "标题" } },
                    "description": { "zh_CN": "面板标题" }
                  },
                  {
                    "property": "menus",
                    "label": { "text": { "zh_CN": "操作项" } },
                    "description": { "zh_CN": "操作项列表；type 为 action 时为字符串数组，否则为对象数组" }
                  },
                  {
                    "property": "type",
                    "label": { "text": { "zh_CN": "类型" } },
                    "description": { "zh_CN": "面板类型，可取 action 或默认值" }
                  },
                  {
                    "property": "showHeader",
                    "label": { "text": { "zh_CN": "显示头部" } },
                    "description": { "zh_CN": "是否显示头部区域" }
                  },
                  {
                    "property": "maskClosable",
                    "label": { "text": { "zh_CN": "点击遮罩关闭" } },
                    "description": { "zh_CN": "点击遮罩时是否关闭面板" }
                  }
                ]
              }
            ],
            "events": {
              "click": {
                "label": { "zh_CN": "点击操作项" },
                "description": { "zh_CN": "点击操作项时触发" }
              },
              "close": {
                "label": { "zh_CN": "关闭" },
                "description": { "zh_CN": "面板关闭时触发" }
              }
            }
          }
        },
        {
          "version": "3.31.0",
          "component": "TinyPopup",
          "name": { "zh_CN": "弹出层" },
          "description": "通用的移动端弹出层，可作为底部弹层、居中弹窗使用",
          "schema": {
            "properties": [
              {
                "label": { "zh_CN": "基础信息" },
                "content": [
                  {
                    "property": "modelValue",
                    "label": { "text": { "zh_CN": "是否显示" } },
                    "description": { "zh_CN": "是否显示弹出层，支持 v-model" }
                  },
                  {
                    "property": "position",
                    "label": { "text": { "zh_CN": "弹出位置" } },
                    "description": { "zh_CN": "弹出位置，可取 center、top、bottom、left、right" }
                  },
                  {
                    "property": "round",
                    "label": { "text": { "zh_CN": "圆角" } },
                    "description": { "zh_CN": "是否显示圆角" }
                  },
                  {
                    "property": "closeable",
                    "label": { "text": { "zh_CN": "显示关闭按钮" } },
                    "description": { "zh_CN": "是否显示关闭图标" }
                  },
                  {
                    "property": "safeAreaInsetBottom",
                    "label": { "text": { "zh_CN": "底部安全区" } },
                    "description": { "zh_CN": "是否开启底部安全区适配" }
                  },
                  {
                    "property": "lockScroll",
                    "label": { "text": { "zh_CN": "锁定滚动" } },
                    "description": { "zh_CN": "弹出时是否锁定背景滚动" }
                  }
                ]
              }
            ],
            "events": {
              "close": {
                "label": { "zh_CN": "关闭" },
                "description": { "zh_CN": "弹出层关闭时触发" }
              }
            },
            "slots": {
              "default": {
                "label": { "zh_CN": "内容" },
                "description": { "zh_CN": "弹出层的内容" }
              }
            }
          }
        },
        {
          "version": "3.31.0",
          "component": "TinyPullRefresh",
          "name": { "zh_CN": "下拉刷新" },
          "description": "包裹可滚动内容，提供下拉刷新交互",
          "schema": {
            "properties": [
              {
                "label": { "zh_CN": "基础信息" },
                "content": [
                  {
                    "property": "modelValue",
                    "label": { "text": { "zh_CN": "加载状态" } },
                    "description": { "zh_CN": "是否处于加载中，支持 v-model" }
                  },
                  {
                    "property": "disabled",
                    "label": { "text": { "zh_CN": "禁用" } },
                    "description": { "zh_CN": "是否禁用下拉刷新" }
                  },
                  {
                    "property": "pullingText",
                    "label": { "text": { "zh_CN": "下拉文字" } },
                    "description": { "zh_CN": "下拉过程中的提示文字" }
                  },
                  {
                    "property": "loosingText",
                    "label": { "text": { "zh_CN": "释放文字" } },
                    "description": { "zh_CN": "释放即可刷新时的提示文字" }
                  },
                  {
                    "property": "loadingText",
                    "label": { "text": { "zh_CN": "加载文字" } },
                    "description": { "zh_CN": "加载中的提示文字" }
                  },
                  {
                    "property": "successText",
                    "label": { "text": { "zh_CN": "成功文字" } },
                    "description": { "zh_CN": "刷新成功后的提示文字" }
                  }
                ]
              }
            ],
            "events": {
              "refresh": {
                "label": { "zh_CN": "刷新" },
                "description": { "zh_CN": "用户下拉触发刷新时调用，完成后需将 modelValue 置为 false" }
              }
            },
            "slots": {
              "default": {
                "label": { "zh_CN": "内容" },
                "description": { "zh_CN": "可滚动的内容" }
              }
            }
          }
        }
      ]
    }
  }
}
