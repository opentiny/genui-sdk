{
  "state": {
    "activeTab": "home"
  },
  "css": ".mobile-page { padding: 16px 16px 72px; background: #f5f5f5; min-height: 100vh; }.mobile-title { margin: 0 0 16px; font-size: 20px; font-weight: 600; }.mobile-card { margin-bottom: 12px; }.mobile-card-title { margin: 0 0 8px; font-size: 16px; }.mobile-card-text { margin: 0; color: #666666; font-size: 14px; }",
  "methods": {
    "onTabChange": {
      "type": "JSFunction",
      "value": "function onTabChange(value) { this.state.activeTab = value; console.log('切换到', value) }"
    }
  },
  "componentName": "Page",
  "props": {
    "className": "mobile-page"
  },
  "children": [
    {
      "componentName": "h2",
      "props": {
        "className": "mobile-title"
      },
      "children": "我的工作台"
    },
    {
      "componentName": "TinyCard",
      "props": {
        "className": "mobile-card"
      },
      "children": [
        {
          "componentName": "h3",
          "props": {
            "className": "mobile-card-title"
          },
          "children": "待办事项"
        },
        {
          "componentName": "p",
          "props": {
            "className": "mobile-card-text"
          },
          "children": "今天有 3 条待办，请及时处理。"
        }
      ]
    },
    {
      "componentName": "TinyCard",
      "props": {
        "className": "mobile-card"
      },
      "children": [
        {
          "componentName": "h3",
          "props": {
            "className": "mobile-card-title"
          },
          "children": "本月工时"
        },
        {
          "componentName": "p",
          "props": {
            "className": "mobile-card-text"
          },
          "children": "已填报 128 小时，剩余 42 小时。"
        }
      ]
    },
    {
      "componentName": "TinyTabbar",
      "props": {
        "modelValue": {
          "type": "JSExpression",
          "value": "this.state.activeTab"
        },
        "onUpdate:modelValue": {
          "type": "JSExpression",
          "value": "this.onTabChange"
        }
      },
      "children": [
        {
          "componentName": "TinyTabbarItem",
          "props": {
            "name": "home",
            "text": "首页"
          }
        },
        {
          "componentName": "TinyTabbarItem",
          "props": {
            "name": "todo",
            "text": "待办",
            "badge": 3
          }
        },
        {
          "componentName": "TinyTabbarItem",
          "props": {
            "name": "me",
            "text": "我的"
          }
        }
      ]
    }
  ]
}
