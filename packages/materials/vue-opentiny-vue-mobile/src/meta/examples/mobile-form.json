{
  "state": {
    "formData": {
      "name": "",
      "phone": "",
      "department": "HR",
      "notify": true
    }
  },
  "css": ".mobile-page { padding: 16px; background: #ffffff; }.mobile-title { margin: 0 0 16px; font-size: 20px; font-weight: 600; }.mobile-actions { margin-top: 24px; }",
  "methods": {
    "submit": {
      "type": "JSFunction",
      "value": "function submit() { if (!this.state.formData.name || !this.state.formData.phone) { this.callAction('continueChat', { message: '请填写姓名和手机号' }); return; } this.callAction('continueChat', { message: '员工信息已提交，请继续' }); }"
    }
  },
  "componentName": "Page",
  "props": {
    "className": "mobile-page"
  },
  "children": [
    {
      "componentName": "h2",
      "props": {
        "className": "mobile-title"
      },
      "children": "员工信息登记"
    },
    {
      "componentName": "TinyForm",
      "props": {
        "model": {
          "type": "JSExpression",
          "value": "this.state.formData"
        },
        "labelPosition": "top"
      },
      "children": [
        {
          "componentName": "TinyFormItem",
          "props": {
            "label": "姓名",
            "prop": "name",
            "required": true
          },
          "children": [
            {
              "componentName": "TinyInput",
              "props": {
                "placeholder": "请输入姓名",
                "modelValue": {
                  "type": "JSExpression",
                  "model": true,
                  "value": "this.state.formData.name"
                }
              }
            }
          ]
        },
        {
          "componentName": "TinyFormItem",
          "props": {
            "label": "手机号",
            "prop": "phone",
            "required": true
          },
          "children": [
            {
              "componentName": "TinyInput",
              "props": {
                "placeholder": "请输入手机号",
                "modelValue": {
                  "type": "JSExpression",
                  "model": true,
                  "value": "this.state.formData.phone"
                }
              }
            }
          ]
        },
        {
          "componentName": "TinyFormItem",
          "props": {
            "label": "部门",
            "prop": "department"
          },
          "children": [
            {
              "componentName": "TinySelect",
              "props": {
                "modelValue": {
                  "type": "JSExpression",
                  "model": true,
                  "value": "this.state.formData.department"
                },
                "options": [
                  { "label": "人事部", "value": "HR" },
                  { "label": "研发部", "value": "RD" },
                  { "label": "市场部", "value": "MK" }
                ]
              }
            }
          ]
        },
        {
          "componentName": "TinyFormItem",
          "props": {
            "label": "接收通知",
            "prop": "notify"
          },
          "children": [
            {
              "componentName": "TinySwitch",
              "props": {
                "modelValue": {
                  "type": "JSExpression",
                  "model": true,
                  "value": "this.state.formData.notify"
                }
              }
            }
          ]
        },
        {
          "componentName": "TinyFormItem",
          "props": {
            "className": "mobile-actions"
          },
          "children": [
            {
              "componentName": "TinyButton",
              "props": {
                "text": "提交",
                "type": "primary",
                "className": "w-full",
                "onClick": {
                  "type": "JSExpression",
                  "value": "this.submit"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
