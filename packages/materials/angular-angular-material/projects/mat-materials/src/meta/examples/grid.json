{
  "state": {
    "displayedColumns": ["name", "department", "position"],
    "displayedData": [
      {
        "name": "张三",
        "department": "研发部",
        "position": "前端工程师"
      },
      {
        "name": "李四",
        "department": "研发部",
        "position": "后端工程师"
      },
      {
        "name": "王五",
        "department": "人事部",
        "position": "HR"
      },
      {
        "name": "赵六",
        "department": "市场部",
        "position": "销售"
      },
      {
        "name": "钱七",
        "department": "财务部",
        "position": "会计"
      }
    ]
  },
  "componentName": "Page",
  "props": {
    "style": "width: 100%; padding: 24px;"
  },
  "children": [
    {
      "componentName": "MatCard",
      "props": {
        "appearance": "outlined"
      },
      "children": [
        {
          "componentName": "MatCardHeader",
          "props": {},
          "children": [
            {
              "componentName": "MatCardTitle",
              "props": {},
              "children": "员工列表（sticky 列/表头 + 空数据行 + 表尾）"
            }
          ]
        },
        {
          "componentName": "MatCardContent",
          "props": {},
          "children": [
            {
              "componentName": "div",
              "props": {
                "style": "max-height: 220px; overflow: auto;"
              },
              "children": [
                {
                  "componentName": "MatTable",
                  "props": {
                    "style": "width: 100%;",
                    "dataSource": {
                      "type": "JSExpression",
                      "value": "this.state.displayedData"
                    }
                  },
                  "children": [
                    {
                      "componentName": "ng-container",
                      "directives": [{ "directiveName": "matColumnDef" }],
                      "props": {
                        "matColumnDef": "name",
                        "sticky": true
                      },
                      "children": [
                        {
                          "componentName": "NgTemplate",
                          "directives": [{ "directiveName": "matHeaderCellDef" }],
                          "children": [
                            {
                              "componentName": "th",
                              "props": { "matHeaderCell": true },
                              "children": "姓名"
                            }
                          ]
                        },
                        {
                          "componentName": "NgTemplate",
                          "directives": [{ "directiveName": "matCellDef" }],
                          "props": { "let": { "row": "$implicit" } },
                          "children": [
                            {
                              "componentName": "td",
                              "props": { "matCell": true },
                              "children": [
                                {
                                  "componentName": "Text",
                                  "props": {
                                    "text": {
                                      "type": "JSExpression",
                                      "value": "row.name"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "componentName": "NgTemplate",
                          "directives": [{ "directiveName": "matFooterCellDef" }],
                          "children": [
                            {
                              "componentName": "td",
                              "props": { "matFooterCell": true },
                              "children": "合计"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "componentName": "ng-container",
                      "directives": [{ "directiveName": "matColumnDef" }],
                      "props": { "matColumnDef": "department" },
                      "children": [
                        {
                          "componentName": "NgTemplate",
                          "directives": [{ "directiveName": "matHeaderCellDef" }],
                          "children": [
                            {
                              "componentName": "th",
                              "props": { "matHeaderCell": true },
                              "children": "部门"
                            }
                          ]
                        },
                        {
                          "componentName": "NgTemplate",
                          "directives": [{ "directiveName": "matCellDef" }],
                          "props": { "let": { "row": "$implicit" } },
                          "children": [
                            {
                              "componentName": "td",
                              "props": { "matCell": true },
                              "children": [
                                {
                                  "componentName": "Text",
                                  "props": {
                                    "text": {
                                      "type": "JSExpression",
                                      "value": "row.department"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "componentName": "NgTemplate",
                          "directives": [{ "directiveName": "matFooterCellDef" }],
                          "children": [
                            {
                              "componentName": "td",
                              "props": { "matFooterCell": true },
                              "children": {
                                "type": "JSExpression",
                                "value": "String(this.state.displayedData.length) + ' 人'"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "componentName": "ng-container",
                      "directives": [{ "directiveName": "matColumnDef" }],
                      "props": { "matColumnDef": "position" },
                      "children": [
                        {
                          "componentName": "NgTemplate",
                          "directives": [{ "directiveName": "matHeaderCellDef" }],
                          "children": [
                            {
                              "componentName": "th",
                              "props": { "matHeaderCell": true },
                              "children": "职位"
                            }
                          ]
                        },
                        {
                          "componentName": "NgTemplate",
                          "directives": [{ "directiveName": "matCellDef" }],
                          "props": { "let": { "row": "$implicit" } },
                          "children": [
                            {
                              "componentName": "td",
                              "props": { "matCell": true },
                              "children": [
                                {
                                  "componentName": "Text",
                                  "props": {
                                    "text": {
                                      "type": "JSExpression",
                                      "value": "row.position"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "componentName": "NgTemplate",
                          "directives": [{ "directiveName": "matFooterCellDef" }],
                          "children": [
                            {
                              "componentName": "td",
                              "props": { "matFooterCell": true },
                              "children": ""
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "componentName": "NgTemplate",
                      "directives": [{ "directiveName": "matHeaderRowDef" }],
                      "props": {
                        "matHeaderRowDef": {
                          "type": "JSExpression",
                          "value": "this.state.displayedColumns"
                        },
                        "matHeaderRowDefSticky": true
                      },
                      "children": [
                        { "componentName": "MatHeaderRow" }
                      ]
                    },
                    {
                      "componentName": "NgTemplate",
                      "directives": [{ "directiveName": "matRowDef" }],
                      "props": {
                        "matRowDefColumns": {
                          "type": "JSExpression",
                          "value": "this.state.displayedColumns"
                        },
                        "let": { "row": "$implicit" }
                      },
                      "children": [
                        { "componentName": "MatRow" }
                      ]
                    },
                    {
                      "componentName": "NgTemplate",
                      "directives": [{ "directiveName": "matNoDataRow" }],
                      "children": [
                        {
                          "componentName": "tr",
                          "props": {
                            "class": "mat-mdc-row mdc-data-table__row"
                          },
                          "children": [
                            {
                              "componentName": "td",
                              "props": {
                                "class": "mat-mdc-cell mdc-data-table__cell",
                                "colSpan": 3,
                                "style": "text-align: center; padding: 16px;"
                              },
                              "children": "暂无数据"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "componentName": "NgTemplate",
                      "directives": [{ "directiveName": "matFooterRowDef" }],
                      "props": {
                        "matFooterRowDef": {
                          "type": "JSExpression",
                          "value": "this.state.displayedColumns"
                        },
                        "matFooterRowDefSticky": true
                      },
                      "children": [
                        { "componentName": "MatFooterRow" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
