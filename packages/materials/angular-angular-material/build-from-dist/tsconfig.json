{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "../dist-ng": ["../dist-ng/index.d.ts"]
    },
    "types": []
  },
  "include": ["./*.ts", "../projects/mat-materials/src/meta/**/*.ts"]
}
