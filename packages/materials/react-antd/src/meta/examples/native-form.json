{
  "name": "Native HTML form",
  "description": "Form built with div, label, input, button — no UI library",
  "schema": {
    "state": {
      "formData": {
        "name": "",
        "email": ""
      }
    },
    "componentName": "Page",
    "props": {
      "style": "max-width: 480px; padding: 16px;"
    },
    "children": [
      {
        "componentName": "h2",
        "props": {},
        "children": [
          {
            "componentName": "Text",
            "props": {
              "text": "Contact form (React native HTML)"
            }
          }
        ]
      },
      {
        "componentName": "form",
        "props": {
          "style": "display: flex; flex-direction: column; gap: 12px;",
          "onSubmit": {
            "type": "JSFunction",
            "value": "function(e) { if (e && e.preventDefault) e.preventDefault(); }"
          }
        },
        "children": [
          {
            "componentName": "label",
            "props": {},
            "children": [
              {
                "componentName": "span",
                "props": {
                  "text": "Name"
                }
              },
              {
                "componentName": "input",
                "props": {
                  "placeholder": "Your name",
                  "modelValue": {
                    "type": "JSExpression",
                    "model": true,
                    "value": "this.state.formData.name"
                  }
                }
              }
            ]
          },
          {
            "componentName": "label",
            "props": {},
            "children": [
              {
                "componentName": "span",
                "props": {
                  "text": "Email"
                }
              },
              {
                "componentName": "input",
                "props": {
                  "type": "email",
                  "placeholder": "email@example.com",
                  "modelValue": {
                    "type": "JSExpression",
                    "model": true,
                    "value": "this.state.formData.email"
                  }
                }
              }
            ]
          },
          {
            "componentName": "button",
            "props": {
              "type": "button",
              "text": "Submit",
              "onClick": {
                "type": "JSFunction",
                "value": "function() { var data = this.state.formData; console.log('submit', data); alert('Submitted:\\n' + JSON.stringify(data, null, 2)); }"
              }
            }
          }
        ]
      }
    ]
  }
}
