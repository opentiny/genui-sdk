{
  "data": {
    "framework": "React",
    "materials": {
      "components": [
        {
          "component": "AntButton",
          "description": "Ant Design 按钮，支持 primary/default/dashed/link/text 等类型",
          "npm": {
            "package": "antd",
            "exportName": "Button",
            "destructuring": true
          },
          "schema": {
            "properties": [
              {
                "label": {
                  "zh_CN": "基础属性"
                },
                "content": [
                  {
                    "property": "type",
                    "type": "string",
                    "description": {
                      "zh_CN": "类型：primary、default、dashed、link、text"
                    }
                  },
                  {
                    "property": "size",
                    "type": "string",
                    "description": {
                      "zh_CN": "尺寸：small、middle、large"
                    }
                  },
                  {
                    "property": "disabled",
                    "type": "boolean"
                  },
                  {
                    "property": "danger",
                    "type": "boolean"
                  }
                ]
              }
            ],
            "events": {
              "onClick": {
                "description": {
                  "zh_CN": "点击事件"
                },
                "type": "event",
                "functionInfo": {
                  "params": [
                    {
                      "name": "event",
                      "type": "Object",
                      "description": {
                        "zh_CN": "鼠标事件对象"
                      }
                    }
                  ],
                  "returns": {}
                }
              }
            }
          }
        },
        {
          "component": "AntInput",
          "description": "Ant Design 输入框",
          "npm": {
            "package": "antd",
            "exportName": "Input",
            "destructuring": true
          },
          "schema": {
            "properties": [
              {
                "label": {
                  "zh_CN": "基础属性"
                },
                "content": [
                  {
                    "property": "value",
                    "type": "string",
                    "description": {
                      "zh_CN": "输入值，可用 model:true 双向绑定"
                    }
                  },
                  {
                    "property": "modelValue",
                    "type": "string",
                    "description": {
                      "zh_CN": "输入值（modelValue 别名）"
                    }
                  },
                  {
                    "property": "placeholder",
                    "type": "string"
                  },
                  {
                    "property": "disabled",
                    "type": "boolean"
                  },
                  {
                    "property": "type",
                    "type": "string",
                    "description": {
                      "zh_CN": "input type：text、password、email 等"
                    }
                  }
                ]
              }
            ],
            "events": {
              "onChange": {
                "description": {
                  "zh_CN": "值变化事件"
                },
                "type": "event",
                "functionInfo": {
                  "params": [
                    {
                      "name": "event",
                      "type": "Object",
                      "description": {
                        "zh_CN": "ChangeEvent，可通过 event.target.value 取值"
                      }
                    }
                  ],
                  "returns": {}
                }
              }
            }
          }
        },
        {
          "component": "AntSelect",
          "description": "Ant Design 下拉选择器",
          "npm": {
            "package": "antd",
            "exportName": "Select",
            "destructuring": true
          },
          "schema": {
            "properties": [
              {
                "label": {
                  "zh_CN": "基础属性"
                },
                "content": [
                  {
                    "property": "value",
                    "type": "string",
                    "description": {
                      "zh_CN": "选中值，可用 model:true 双向绑定"
                    }
                  },
                  {
                    "property": "placeholder",
                    "type": "string"
                  },
                  {
                    "property": "disabled",
                    "type": "boolean"
                  },
                  {
                    "property": "options",
                    "type": "array",
                    "defaultValue": [],
                    "description": {
                      "zh_CN": "选项数组，如 [{ label: '男', value: 'male' }]"
                    }
                  }
                ]
              }
            ],
            "events": {
              "onChange": {
                "description": {
                  "zh_CN": "选中值变化"
                },
                "type": "event",
                "functionInfo": {
                  "params": [
                    {
                      "name": "value",
                      "type": "any",
                      "description": {
                        "zh_CN": "当前选中值"
                      }
                    },
                    {
                      "name": "option",
                      "type": "Object",
                      "description": {
                        "zh_CN": "当前选中项"
                      }
                    }
                  ],
                  "returns": {}
                }
              }
            }
          }
        },
        {
          "component": "AntForm",
          "description": "Ant Design 表单容器",
          "npm": {
            "package": "antd",
            "exportName": "Form",
            "destructuring": true
          },
          "schema": {
            "properties": [
              {
                "label": {
                  "zh_CN": "基础属性"
                },
                "content": [
                  {
                    "property": "layout",
                    "type": "string",
                    "defaultValue": "vertical",
                    "description": {
                      "zh_CN": "布局：horizontal、vertical、inline"
                    }
                  }
                ]
              }
            ],
            "slots": {
              "default": {
                "description": {
                  "zh_CN": "表单项子节点，通常放 AntFormItem"
                }
              }
            }
          }
        },
        {
          "component": "AntFormItem",
          "description": "Ant Design 表单项，包含 label 与输入控件。数据绑定请在子组件（AntInput/AntSelect 等）上使用 modelValue 或 value（model:true），不要设置 name 属性",
          "npm": {
            "package": "antd",
            "exportName": "Form.Item",
            "destructuring": true
          },
          "schema": {
            "properties": [
              {
                "label": {
                  "zh_CN": "基础属性"
                },
                "content": [
                  {
                    "property": "label",
                    "type": "string",
                    "description": {
                      "zh_CN": "表单项标签"
                    }
                  },
                  {
                    "property": "required",
                    "type": "boolean",
                    "description": {
                      "zh_CN": "是否必填（仅展示）"
                    }
                  }
                ]
              }
            ],
            "slots": {
              "default": {
                "description": {
                  "zh_CN": "表单项内容，如 AntInput、AntSelect"
                }
              }
            }
          }
        },
        {
