{
  "data": {
    "framework": "React",
    "materials": {
      "components": [
        {
          "component": "AntBar",
          "description": "Ant Design 条形图（水平方向），通过 data 与 xField/yField 配置数据",
          "npm": {
            "package": "@ant-design/plots",
            "exportName": "Bar",
            "destructuring": true
          },
          "schema": {
            "properties": [
              {
                "label": {
                  "zh_CN": "基础属性"
                },
                "content": [
                  {
                    "property": "data",
                    "type": "array",
                    "required": true,
                    "defaultValue": [],
                    "description": {
                      "zh_CN": "数据数组，元素为对象"
                    }
                  },
                  {
                    "property": "xField",
                    "type": "string",
                    "required": true,
                    "defaultValue": "x",
                    "description": {
                      "zh_CN": "x 轴字段名，取 data 中对象的 key"
                    }
                  },
                  {
                    "property": "yField",
                    "type": "string",
                    "required": true,
                    "defaultValue": "y",
                    "description": {
                      "zh_CN": "y 轴字段名，取 data 中对象的 key"
                    }
                  },
                  {
                    "property": "colorField",
                    "type": "string",
                    "description": {
                      "zh_CN": "分组/颜色字段名，多系列时使用"
                    }
                  },
                  {
                    "property": "stack",
                    "type": "boolean",
                    "description": {
                      "zh_CN": "是否堆叠"
                    }
                  },
                  {
                    "property": "height",
                    "type": "number",
                    "defaultValue": 320,
                    "description": {
                      "zh_CN": "图表高度"
                    }
                  }
                ]
              }
            ]
          }
        },
