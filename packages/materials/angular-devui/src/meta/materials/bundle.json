                  {
                    "property": "size",
                    "type": "string",
                    "label": { "text": { "zh_CN": "尺寸" } },
                    "widget": {
                      "component": "SelectConfigurator",
                      "props": {
                        "options": [
                          { "label": "sm", "value": "sm" },
                          { "label": "md", "value": "md" },
                          { "label": "lg", "value": "lg" }
                        ]
                      }
                    }
                  },
                  {
                    "property": "borderType",
                    "type": "string",
                    "label": { "text": { "zh_CN": "边框类型" } },
                    "widget": {
                      "component": "SelectConfigurator",
                      "props": {
                        "options": [
                          { "label": "default", "value": "" },
                          { "label": "bordered", "value": "bordered" },
                          { "label": "borderless", "value": "borderless" }
                        ]
                      }
                    }
                  },
                  {
                    "property": "headerBg",
                    "type": "boolean",
                    "defaultValue": false,
                    "label": { "text": { "zh_CN": "表头背景" } },
                    "widget": { "component": "CheckBoxConfigurator", "props": {} }
                  }
                ]
              }
            ],
            "events": {
              "rowClick": {
                "label": { "zh_CN": "行点击" },
                "type": "event"
              },
              "cellClick": {
                "label": { "zh_CN": "单元格点击" },
                "type": "event"
              },
              "rowCheckChange": {
                "label": { "zh_CN": "行勾选变化" },
                "type": "event"
              },
              "checkAllChange": {
                "label": { "zh_CN": "全选变化" },
                "type": "event"
              },
              "multiSortChange": {
                "label": { "zh_CN": "排序变化" },
                "type": "event"
              }
            },
            "slots": {}
          }
        },
