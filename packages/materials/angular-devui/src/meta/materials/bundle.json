                    "defaultValue": false,
                    "label": { "text": { "zh_CN": "固定表头" } },
                    "widget": { "component": "CheckBoxConfigurator", "props": {} }
                  },
                  {
                    "property": "striped",
                    "type": "boolean",
                    "defaultValue": false,
                    "label": { "text": { "zh_CN": "斑马纹" } },
                    "widget": { "component": "CheckBoxConfigurator", "props": {} }
                  },
                  {
                    "property": "checkable",
                    "type": "boolean",
                    "defaultValue": false,
                    "label": { "text": { "zh_CN": "可勾选" } },
                    "widget": { "component": "CheckBoxConfigurator", "props": {} }
                  },
                  {
                    "property": "tableWidth",
                    "type": "string",
                    "label": { "text": { "zh_CN": "表格宽度" } },
                    "widget": { "component": "InputConfigurator", "props": {} }
                  },
                  {
                    "property": "tableHeight",
                    "type": "string",
                    "label": { "text": { "zh_CN": "表格高度" } },
                    "widget": { "component": "InputConfigurator", "props": {} }
                  },
                  {
                    "property": "maxHeight",
                    "type": "string",
                    "label": { "text": { "zh_CN": "最大高度" } },
                    "widget": { "component": "InputConfigurator", "props": {} }
