                    "description": { "zh_CN": "表格显示的数据数组" },
                    "widget": { "component": "CodeConfigurator", "props": { "language": "json" } }
                  },
                  {
                    "property": "scrollable",
                    "type": "boolean",
                    "defaultValue": false,
                    "label": { "text": { "zh_CN": "可滚动" } },
                    "widget": { "component": "CheckBoxConfigurator", "props": {} }
