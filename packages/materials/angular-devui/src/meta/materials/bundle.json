        {
          "version": "18.0.0",
          "name": { "zh_CN": "日期选择器" },
          "component": "DDatePicker",
          "icon": "datepick",
          "description": "DevUI DatepickerPro，用于选择日期或时间",
          "doc_url": "https://devui.design/components/zh-cn/datepickerpro/demo",
          "npm": {
            "package": "ng-devui",
            "exportName": "DatepickerProComponent",
            "destructuring": true
          },
          "group": "表单组件",
          "category": "ng-devui",
          "configure": {
            "isContainer": false,
            "isPopper": true,
            "framework": "Angular",
            "shortcuts": {
              "properties": ["ngModel", "placeholder", "format", "showTime"]
            }
          },
          "schema": {
            "properties": [
              {
                "label": { "zh_CN": "基础属性" },
                "content": [
                  {
                    "property": "ngModel",
                    "type": "date",
                    "required": true,
                    "label": { "text": { "zh_CN": "绑定值" } },
                    "description": { "zh_CN": "选中的日期" },
                    "widget": { "component": "DateConfigurator", "props": {} }
                  },
                  {
                    "property": "placeholder",
                    "type": "string",
                    "defaultValue": "请选择日期",
                    "label": { "text": { "zh_CN": "占位文本" } },
                    "widget": { "component": "InputConfigurator", "props": {} }
                  },
                  {
                    "property": "format",
                    "type": "string",
                    "defaultValue": "yyyy-MM-dd",
                    "label": { "text": { "zh_CN": "显示格式" } },
                    "widget": { "component": "InputConfigurator", "props": {} }
                  },
                  {
                    "property": "showTime",
                    "type": "boolean",
                    "defaultValue": false,
                    "label": { "text": { "zh_CN": "显示时分秒" } },
                    "widget": { "component": "CheckBoxConfigurator", "props": {} }
                  },
                  {
                    "property": "mode",
                    "type": "string",
                    "defaultValue": "date",
                    "label": { "text": { "zh_CN": "选择类型" } },
                    "widget": {
                      "component": "SelectConfigurator",
                      "props": {
                        "options": [
                          { "label": "date", "value": "date" },
                          { "label": "month", "value": "month" },
                          { "label": "year", "value": "year" }
                        ]
                      }
                    }
                  },
                  {
                    "property": "disabled",
                    "type": "boolean",
                    "defaultValue": false,
                    "label": { "text": { "zh_CN": "禁用" } },
                    "widget": { "component": "CheckBoxConfigurator", "props": {} }
                  },
                  {
                    "property": "allowClear",
                    "type": "boolean",
                    "defaultValue": true,
                    "label": { "text": { "zh_CN": "允许清空" } },
                    "widget": { "component": "CheckBoxConfigurator", "props": {} }
                  },
                  {
                    "property": "width",
                    "type": "string",
                    "label": { "text": { "zh_CN": "宽度" } },
                    "widget": { "component": "InputConfigurator", "props": {} }
                  }
                ]
              }
            ],
            "events": {
              "confirmEvent": {
                "label": { "zh_CN": "确认选择" },
                "description": { "zh_CN": "用户确认选定日期时触发" },
                "type": "event",
                "functionInfo": {
                  "params": [{ "name": "date", "type": "Date", "description": { "zh_CN": "选中日期" } }],
                  "returns": {}
                }
              },
              "dropdownToggle": {
                "label": { "zh_CN": "面板开关" },
                "description": { "zh_CN": "下拉面板打开或关闭时触发" },
                "type": "event"
              }
            },
            "slots": {}
          }
        },
        {
          "version": "18.0.0",
          "name": { "zh_CN": "数据表格" },
          "component": "DDataTable",
