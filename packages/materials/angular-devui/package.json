{
  "name": "@opentiny/genui-sdk-materials-angular-devui",
  "version": "0.0.1",
  "description": "GenUI Angular materials package based on ng-devui",
  "author": "OpenTiny Team",
  "license": "MIT",
  "homepage": "https://opentiny.design/genui-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/opentiny/genui-sdk",
    "directory": "packages/materials/angular-devui"
  },
  "bugs": {
    "url": "https://github.com/opentiny/genui-sdk/issues"
  },
  "keywords": [
    "genui",
    "generative-ui",
    "devui",
    "ng-devui",
    "angular",
    "materials"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./meta": {
      "types": "./dist/meta.d.ts",
      "import": "./dist/meta.js",
      "require": "./dist/meta.js"
    },
    "./materials": {
      "types": "./dist/materials.d.ts",
      "import": "./dist/materials.js",
      "require": "./dist/materials.js"
    }
  },
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@angular/core": "^20.3.0",
    "@opentiny/genui-sdk-core": "workspace:*",
    "echarts": "^5.6.0",
    "ng-devui": "^18.0.0"
  },
  "peerDependencies": {
    "@angular/animations": ">=18.0.0",
    "@angular/common": ">=18.0.0",
    "@angular/forms": ">=18.0.0"
  },
  "devDependencies": {
    "escape-string-regexp": "^1.0.5",
    "typescript": "^5.8.2",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0"
  }
}
