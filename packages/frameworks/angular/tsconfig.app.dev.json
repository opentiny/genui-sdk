/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@opentiny/genui-sdk-core": [
        "../../core/src/index.ts"
      ],
      "@opentiny/genui-sdk-angular": [
        "./projects/renderer/src/public-api.ts"
      ],
      "@opentiny/tiny-schema-renderer-ng": [
        "../../../projects/tiny-schema-renderer-ng/projects/renderer/src/public-api.ts"
      ],
      "@opentiny/genui-sdk-materials-angular-angular-material": [
        "../../materials/angular-angular-material/projects/mat-materials/src/index.ts"
      ],
      "@opentiny/genui-sdk-materials-angular-angular-material/materials": [
        "../../materials/angular-angular-material/projects/mat-materials/src/materials/index.ts"
      ],
      "@opentiny/genui-sdk-materials-angular-angular-material/meta": [
        "../../materials/angular-angular-material/projects/mat-materials/src/meta/index.ts"
      ],
      "@opentiny/genui-sdk-materials-angular-angular-material/patch": [
        "../../materials/angular-angular-material/projects/mat-materials/src/patch.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "projects/renderer/src/**/*.ts",
    "../../core/src/**/*.ts",
    "../../../projects/tiny-schema-renderer-ng/projects/renderer/src/**/*.ts",
    "../../materials/angular-angular-material/projects/mat-materials/src/**/*.ts"
  ]
}
