{
    "componentName": "Page",
    "props": {
      "style": "width: 100%; padding: 24px;"
    },
    "state": {
      "basicDataSource": [
        {
          "id": 1,
          "firstName": "Mark",
          "lastName": "Otto",
          "dob": "1990-12-01",
          "gender": { "id": 1, "label": "Male" },
          "age": 24
        },
        {
          "id": 2,
          "firstName": "Jacob",
          "lastName": "Thornton",
          "dob": "1989-01-01",
          "gender": { "id": 2, "label": "Female" },
          "age": 24
        },
        {
          "id": 3,
          "firstName": "Danni",
          "lastName": "Chen",
          "dob": "2018-03-01",
          "gender": { "id": 2, "label": "Female" },
          "age": 24
        },
        {
          "id": 4,
          "firstName": "green",
          "lastName": "gerong",
          "dob": "2018-03-01",
          "gender": { "id": 1, "label": "Male" },
          "age": 24
        },
        {
          "id": 5,
          "firstName": "po",
          "lastName": "lang",
          "dob": "2018-03-01",
          "gender": { "id": 1, "label": "Male" },
          "age": 24,
          "detail": "这是一个行详情"
        },
        {
          "id": 6,
          "firstName": "john",
          "lastName": "li",
          "dob": "2018-03-01",
          "gender": { "id": 2, "label": "Female" },
          "age": 24
        }
      ],
      "genderSource": [
        { "id": 1, "label": "Male" },
        { "id": 2, "label": "Female" }
      ]
    },
    "methods": {
      "beforeCellEdit": {
        "type": "JSFunction",
        "value": "function() { return new Promise((resolve) => { console.log('beforeCellEdit'); resolve(undefined); }); }"
      },
      "beforeCellEditEnd": {
        "type": "JSFunction",
        "value": "function(rowItem, column) { console.log('before edit end:', rowItem, column); if (column.field === 'lastName' && rowItem[column.field].length < 3) { return false; } return true; }"
      },
      "thisCellEditEnd": {
        "type": "JSFunction",
        "value": "function(event) { console.log('cellEditEnd'); console.log(event.rowItem); }"
      },
      "finishEdit": {
        "type": "JSFunction",
        "value": "function() { if (this.refs.dataTable) { this.refs.dataTable.cancelEditingStatus(); } }"
      }
    },
    "children": [
      {
        "componentName": "DDataTable",
        "props": {
          "ref": {
            "type": "JSFunction",
            "value": "function(instance) { this.refs.dataTable = instance; }"
          },
          "dataSource": {
            "type": "JSExpression",
            "value": "this.state.basicDataSource"
          },
          "beforeCellEdit": {
            "type": "JSExpression",
            "value": "this.beforeCellEdit"
          },
          "beforeCellEditEnd": {
            "type": "JSExpression",
            "value": "this.beforeCellEditEnd"
          },
          "onCellEditEnd": {
            "type": "JSExpression",
            "value": "this.thisCellEditEnd"
          },
          "scrollable": true,
          "tableOverflowType": "overlay"
        },
        "children": [
          {
            "componentName": "DColumn",
            "props": {
              "field": "lastName",
              "header": "Last Name",
              "width": "100px",
              "editable": true
            },
            "children": [
              {
                "componentName": "DCellEdit",
                "children": [
                  {
                    "componentName": "NgTemplate",
                    "props": {
                      "let": {
                        "rowItem": "rowItem",
                        "column": "column"
                      }
                    },
                    "children": [
                      {
                        "componentName": "div",
                        "props": {
                          "class": "customized-editor edit-padding-fix"
                        },
                        "children": [
                          {
                            "componentName": "input",
                            "props": {
                              "class": "devui-form-control",
                              "maxlength": "5",
                              "dAutoFocus": true,
                              "ngModel": {
                                "type": "JSExpression",
                                "model": true,
                                "value": "rowItem[column.field]"
                              }
                            },
                            "directives": [
                              {
                                "directiveName": "ngModel"
                              },
                              {
                                "directiveName": "dAutoFocus"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "componentName": "DColumn",
            "props": {
              "field": "dob",
              "header": "Date of birth",
              "editable": true,
              "width": "150px"
            },
            "children": [
              {
                "componentName": "DCell",
                "children": [
                  {
                    "componentName": "NgTemplate",
                    "props": {
                      "let": {
                        "cellItem": "cellItem"
                      }
                    },
                    "children": [
                      {
                        "componentName": "Text",
                        "props": {
                          "text": {
                            "type": "JSExpression",
                            "value": "new Date(cellItem).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "componentName": "DCellEdit",
                "children": [
                  {
                    "componentName": "NgTemplate",
                    "props": {
                      "let": {
                        "rowItem": "rowItem",
                        "column": "column"
                      }
                    },
                    "children": [
                      {
                        "componentName": "form",
                        "props": {
                          "class": "form-inline edit-padding-fix"
                        },
                        "directives": [
                          {
                            "directiveName": "ngForm"
                          },
                          {
                            "directiveName": "defaultValueAccessor"
                          }
                        ],
                        "children": [
                          {
                            "componentName": "div",
                            "props": {
                              "class": "devui-form-group"
                            },
                            "children": [
                              {
                                "componentName": "div",
                                "props": {
                                  "class": "devui-input-group devui-dropdown-origin"
                                },
                                "children": [
                                  {
                                    "componentName": "input",
                                    "props": {
                                      "class": "devui-form-control search",
                                      "name": {
                                        "type": "JSExpression",
                                        "value": "column.field"
                                      },
                                      "dateFormat": "y-MM-dd",
                                      "showTime": true,
                                      "autoOpen": true,
                                      "ngModel": {
                                        "type": "JSExpression",
                                        "model": true,
                                        "value": "rowItem[column.field]"
                                      }
                                    },
                                    "directives": [
                                      {
                                        "directiveName": "ngModel"
                                      },
                                      {
                                        "directiveName": "dDatepicker"
                                      }
                                    ]
                                  },
                                  {
                                    "componentName": "div",
                                    "props": {
                                      "class": "devui-input-group-addon"
                                    },
                                    "children": [
                                      {
                                        "componentName": "i",
                                        "props": {
                                          "class": "icon icon-calendar"
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "componentName": "DColumn",
            "props": {
              "field": "age",
              "header": "Age",
              "editable": true,
              "width": "100px"
            },
            "children": [
              {
                "componentName": "DCellEdit",
                "children": [
                  {
                    "componentName": "NgTemplate",
                    "props": {
                      "let": {
                        "rowItem": "rowItem",
                        "column": "column"
                      }
                    },
                    "children": [
                      {
                        "componentName": "DInputNumber",
                        "props": {
                          "autoFocus": true,
                          "class": "input-number",
                          "ngModel": {
                            "type": "JSExpression",
                            "model": true,
                            "value": "rowItem[column.field]"
                          }
                        },
                        "directives": [
                          {
                            "directiveName": "ngModel"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "componentName": "DColumn",
            "props": {
              "field": "gender",
              "header": "Gender",
              "editable": true,
              "width": "100px"
            },
            "children": [
              {
                "componentName": "DCell",
                "children": [
                  {
                    "componentName": "NgTemplate",
                    "props": {
                      "let": {
                        "cellItem": "cellItem"
                      }
                    },
                    "children": [
                      {
                        "componentName": "Text",
                        "props": {
                          "text": {
                            "type": "JSExpression",
                            "value": "cellItem.label"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "componentName": "DCellEdit",
                "children": [
                  {
                    "componentName": "NgTemplate",
                    "props": {
                      "let": {
                        "rowItem": "rowItem",
                        "column": "column"
                      }
                    },
                    "children": [
                      {
                        "componentName": "div",
                        "props": {
                          "class": "customized-editor edit-padding-fix"
                        },
                        "children": [
                          {
                            "componentName": "DSelect",
                            "props": {
                              "options": {
                                "type": "JSExpression",
                                "value": "this.state.genderSource"
                              },
                              "isSearch": true,
                              "filterKey": "label",
                              "appendToBody": true,
                              "autoFocus": true,
                              "toggleOnFocus": true,
                              "ngModel": {
                                "type": "JSExpression",
                                "model": true,
                                "value": "rowItem[column.field]"
                              },
                              "onNgModelChange": {
                                "type": "JSFunction",
                                "value": "function(value) { rowItem[column.field] = value; this.finishEdit(); }"
                              }
                            },
                            "children": [
                              {
                                "componentName": "NgTemplate",
                                "props": {
                                  "let": {
                                    "option": "option",
                                    "filterKey": "filterKey"
                                  }
                                },
                                "children": [
                                  {
                                    "componentName": "Text",
                                    "props": {
                                      "text": {
                                        "type": "JSExpression",
                                        "value": "`gender:${option[filterKey]}`"
                                      }
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }