        "email": "lina@example.com"
      },
      {
        "name": "王强",
        "id": "3",
        "sex": "男",
        "department": "测试部",
        "protocolStart": "2020-03-20",
        "email": "wangqiang@example.com"
      },
      {
        "name": "刘洋",
        "id": "4",
        "sex": "男",
        "department": "市场部",
        "protocolStart": "2021-07-08",
        "email": "liuyang@example.com"
      }
    ],
    "dataTableOptions": {
      "columns": [
        { "field": "name", "header": "姓名", "fieldType": "text" },
        { "field": "id", "header": "工号", "fieldType": "text" },
        { "field": "sex", "header": "性别", "fieldType": "text" },
        { "field": "department", "header": "部门", "fieldType": "text" },
        { "field": "protocolStart", "header": "入职日期", "fieldType": "date" },
        { "field": "email", "header": "邮箱", "fieldType": "text" }
      ]
    },
    "tableWidthConfig": [
      { "field": "name", "width": "120px" },
      { "field": "id", "width": "100px" },
      { "field": "sex", "width": "80px" },
      { "field": "department", "width": "120px" },
      { "field": "protocolStart", "width": "140px" },
      { "field": "email", "width": "220px" }
    ]
  },
  "children": [
    {
      "componentName": "DDataTable",
      "props": {
        "dataSource": {
          "type": "JSExpression",
          "value": "this.state.basicDataSource"
        },
        "scrollable": true,
        "tableWidthConfig": {
          "type": "JSExpression",
          "value": "this.state.tableWidthConfig"
        },
        "tableOverflowType": "overlay"
      },
      "children": [
        {
          "componentName": "DTableHead",
          "children": [
            {
              "componentName": "DTableTr",
              "children": [
                {
                  "componentName": "DTableTh",
                  "children": "#"
                },
                {
                  "componentName": "DTableTh",
                  "loop": {
                    "type": "JSExpression",
                    "value": "this.state.dataTableOptions.columns"
                  },
                  "loopArgs": ["colOption"],
                  "children": [
                    {
                      "componentName": "Text",
                      "props": {
                        "text": {
                          "type": "JSExpression",
                          "value": "colOption.header"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "componentName": "DTableBody",
          "children": [
            {
              "componentName": "NgTemplate",
              "props": {
                "let": {
                  "rowItem": "rowItem",
                  "rowIndex": "rowIndex"
                }
              },
              "children": [
                {
                  "componentName": "DTableTr",
                  "children": [
                    {
                      "componentName": "DTableTd",
                      "children": [
                        {
                          "componentName": "Text",
                          "props": {
                            "text": {
                              "type": "JSExpression",
                              "value": "rowIndex + 1"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "componentName": "DTableTd",
                      "loop": {
                        "type": "JSExpression",
                        "value": "this.state.dataTableOptions.columns"
                      },
                      "loopArgs": ["colOption"],
                      "children": [
                        {
                          "componentName": "Text",
                          "props": {
                            "text": {
                              "type": "JSExpression",
                              "value": "rowItem[colOption.field]"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
