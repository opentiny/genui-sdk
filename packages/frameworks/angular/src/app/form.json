{
  "state": {
    "formData": {
      "name": "张三",
      "department": "HR",
      "sex": "男",
      "enabled": true,
      "email": ""
    }
  },
  "methods": {
    "handleSubmit": {
      "type": "JSFunction",
      "value": "function handleSubmit() { console.log(this.state.formData) }"
    },
    "handleReset": {
      "type": "JSFunction",
      "value": "function handleReset() { this.state.formData.name = ''; this.state.formData.department = '' }"
    }
  },
  "componentName": "Page",
  "props": {
    "style": "width: 100%; padding: 24px;"
  },
  "children": [
    {
      "componentName": "h3",
      "props": {},
      "children": "员工信息"
    },
    {
      "componentName": "div", 
      "props": {
        "style": "display: flex; flex-direction: column; gap: 24px; margin-top: 16px;"
      },
      "children": [
        {
          "componentName": "MatFormField",
          "props": {
            "appearance": "outline",
            "floatLabel": "auto"
          },
          "children": [
            {
              "componentName": "mat-label",
              "props": {},
              "children": "姓名",
              "directives": [
                {
                  "directiveName": "matLabel"
                }
              ]
            },
            {
              "componentName": "input",
              "props": {
                "matInput": true,
                "placeholder": "请输入姓名",
                "ngModel": {
                  "type": "JSExpression",
                  "model": true,
                  "value": "this.state.formData.name"
                }
              },
              "directives": [
                {
                  "directiveName": "ngModel"
                },
                {
                  "directiveName": "matInput"
                }
              ]
            }
          ]
        },
        {
          "componentName": "MatFormField",
          "props": {
            "appearance": "outline"
          },
          "children": [
            {
              "componentName": "MatLabel",
              "props": {},
              "children": "部门"
            },
            {
              "componentName": "MatSelect",
              "props": {
                "placeholder": "请选择部门",
                "ngModel": {
                  "type": "JSExpression",
                  "model": true,
                  "value": "this.state.formData.department"
                }
              },
              "directives": [
                {
                  "directiveName": "ngModel"
                }
              ],
              "children": [
                {
                  "componentName": "MatOption",
                  "props": {
                    "value": "HR"
                  },
                  "children": "人事部"
                },
                {
                  "componentName": "MatOption",
                  "props": {
                    "value": "R&D"
                  },
                  "children": "研发部"
                },
                {
                  "componentName": "MatOption",
                  "props": {
                    "value": "finance"
                  },
                  "children": "财务部"
                }
              ]
            }
          ]
        },
        {
          "componentName": "div",
          "props": {
            "style": "display: flex; flex-direction: column; gap: 8px;"
          },
          "children": [
            {
              "componentName": "label",
              "props": {
                "style": "font-weight: bold;"
              },
              "children": "性别"
            },
            {
              "componentName": "MatRadioGroup",
              "props": {
                "ngModel": {
                  "type": "JSExpression",
                  "model": true,
                  "value": "this.state.formData.sex"
                }
              },
              "directives": [
                {
                  "directiveName": "ngModel"
                }
              ],
              "children": [
                {
                  "componentName": "MatRadioButton",
                  "props": {
                    "value": "男"
                  },
                  "children": "男"
                },
                {
                  "componentName": "MatRadioButton",
                  "props": {
                    "value": "女"
                  },
                  "children": "女"
                }
              ]
            }
          ]
        },
        {
          "componentName": "MatSlideToggle",
          "props": {
            "ngModel": {
              "type": "JSExpression",
              "model": true,
              "value": "this.state.formData.enabled"
            }
          },
          "directives": [
            {
              "directiveName": "ngModel"
            }
          ],
          "children": "是否启用"
        },
        {
          "componentName": "div",
          "props": {
            "style": "display: flex; gap: 16px; margin-top: 8px;"
          },
          "children": [
            {
              "componentName": "MatButton",
              "props": {
                "appearance": "filled",
                "color": "primary",
                "onClick": {
                  "type": "JSExpression",
                  "value": "this.handleSubmit"
                }
              },
              "children": "提交"
            },
            {
              "componentName": "MatButton",
              "props": {
                "appearance": "outlined",
                "onClick": {
                  "type": "JSExpression",
                  "value": "this.handleReset"
                }
              },
              "children": "重置"
            }
          ]
        }
      ]
    }
  ]
}
