  "children": [
    {
      "componentName": "DDataTable",
      "props": {
        "dataSource": {
          "type": "JSExpression",
          "value": "this.state.basicDataSource"
        },
        "scrollable": true,
        "tableOverflowType": "overlay"
      },
      "children": [
        {
          "componentName": "DColumn",
          "props": {
            "field": "$index",
            "header": "#",
            "width": "50px"
          }
        },
        {
          "componentName": "DColumn",
          "loop": {
            "type": "JSExpression",
            "value": "this.state.dataTableOptions.columns"
          },
          "loopArgs": ["colOption"],
          "props": {
            "field": {
              "type": "JSExpression",
              "value": "colOption.field"
            },
            "header": {
              "type": "JSExpression",
              "value": "colOption.header"
            },
            "fieldType": {
              "type": "JSExpression",
              "value": "colOption.fieldType"
            },
