{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "types": []
  },
  // 只收 5175 出码页:同目录的 preview*.ts / generated 是 4201 那个 Angular app,归 src/tsconfig.app.json。
  "include": ["src/main.ts", "src/demo-schema.ts", "src/headless/**/*.ts"]
}
