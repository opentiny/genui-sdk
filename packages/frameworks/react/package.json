{
  "name": "@opentiny/genui-sdk-react",
  "version": "1.0.0",
  "description": "A React component library for GenUI schema rendering",
  "author": "OpenTiny Team",
  "license": "MIT",
  "homepage": "https://opentiny.design/genui-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/opentiny/genui-sdk",
    "directory": "packages/frameworks/react"
  },
  "bugs": {
    "url": "https://github.com/opentiny/genui-sdk/issues"
  },
  "keywords": [
    "react",
    "component",
    "library",
    "llm",
    "generative-ui",
    "stream-ui"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./config-provider": {
      "types": "./dist/config-provider.d.ts",
      "import": "./dist/config-provider.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prebuild:lib:npm": "pnpm -F @opentiny/genui-sdk-core build && pnpm -F @opentiny/tiny-schema-renderer-react build",
    "build:lib:npm": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentiny/genui-sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@opentiny/tiny-schema-renderer-react": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "escape-string-regexp": "^1.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
